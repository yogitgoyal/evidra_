# Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values with your actual configuration.

# Neon PostgreSQL connection string (AsyncPG driver)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<ep-pooler-hostname>.neon.tech/<dbname>?sslmode=require

# JWT Secret Key for Session Authentication
SECRET_KEY=your-secret-key-here-change-in-production

# Demo Credentials
DEMO_USERNAME=demo
DEMO_PASSWORD=evidra-demo

# Optional: CORS Allowed Origins (comma-separated)
EVIDRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: OpenAI API Key for Story Narration
OPENAI_API_KEY=
